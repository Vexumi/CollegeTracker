@using KST.Business.Notifications.Models;
@model ProjectStateChangedNotification;

<div>
    <text>Статус проекта в системе "Student Tracker" изменен!</text><br/>
    <br/>
    <text>Название проекта: @Model.ProjectName</text><br/>
