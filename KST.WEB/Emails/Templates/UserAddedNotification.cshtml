@using KST.Business.Notifications.Models;
@model UserAddedNotification;

<div>
    <text>Уважаемый(ая) @Model.Fullname, для вас создана учетная запись в системе "Student Tracker"</text><br/>
    <br/>
    <text>Имя пользователя: @Model.UserName</text><br/>
    <text>Электронная почта: @Model.Email</text><br/>
    <text>Пароль: @Model.Password</text><br/>
    <text>Ссылка: @Model.FrontendLink</text><br/>
    <br/>
    <text>Внимание! При первой авторизации в систему рекомендуется сменить пароль на странице профиля!</text>
</div>